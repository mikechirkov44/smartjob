# Incremental release for an existing SmartJob installation, preserving dependency layers.
# For a clean installation use apps/api/Dockerfile.
ARG PREVIOUS_IMAGE=smartjob-api:local
FROM ${PREVIOUS_IMAGE} AS build
WORKDIR /app
COPY apps/api/nest-cli.json apps/api/tsconfig.json apps/api/tsconfig.build.json ./
COPY apps/api/src ./src
COPY apps/api/prisma ./prisma
RUN npx prisma generate && npm run build

FROM ${PREVIOUS_IMAGE}
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/prisma ./prisma
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
