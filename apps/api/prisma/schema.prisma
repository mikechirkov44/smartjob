generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum OrgRole {
  OWNER
  ADMIN
  HR
  VIEWER
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SurveyTemplate {
  FULL
  PULSE
  CUSTOM
  WORK_CONDITIONS
}

enum QuestionType {
  LIKERT
  ENPS
  TEXT
  GRID
  SINGLE
  MULTI
}

enum LinkType {
  PUBLIC
  PERSONAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  globalRole   GlobalRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  OrganizationMember[]
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  industry     String   @default("IT / Разработка ПО")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      OrganizationMember[]
  departments  Department[]
  employees    Employee[]
  surveys      Survey[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(HR)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  fullName       String
  email          String?
  grade          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  links          SurveyLink[]
  responses      Response[]

  @@index([organizationId])
  @@index([departmentId])
}

model Survey {
  id                          String         @id @default(cuid())
  organizationId              String
  title                       String
  description                 String?
  coverImage                  String         @default("team-collab")
  template                    SurveyTemplate
  status                      SurveyStatus   @default(DRAFT)
  includeEnps                 Boolean        @default(true)
  hideQuestionCategory        Boolean        @default(false)
  adminCanIdentifyRespondents Boolean        @default(false)
  closesAt                    DateTime?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  organization                Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions                   SurveyQuestion[]
  links                       SurveyLink[]
  responses                   Response[]

  @@index([organizationId])
  @@index([status])
}

model SurveyQuestion {
  id             String       @id @default(cuid())
  surveyId       String
  sortOrder      Int
  type           QuestionType @default(LIKERT)
  scaleMax       Int          @default(5)
  scaleMinLabel  String?
  scaleMaxLabel  String?
  gridRows       Json?
  gridColumns    Json?
  requireAllRows Boolean      @default(true)
  choices        Json?
  allowOther     Boolean      @default(false)
  metric         String?
  category       String?
  text           String
  survey         Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers        Answer[]

  @@index([surveyId])
}

model SurveyLink {
  id         String    @id @default(cuid())
  surveyId   String
  employeeId String?
  token      String    @unique
  type       LinkType  @default(PUBLIC)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  survey     Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  responses  Response[]

  @@index([surveyId])
  @@index([employeeId])
}

model Response {
  id                 String   @id @default(cuid())
  surveyId           String
  linkId             String
  employeeId         String?
  departmentName     String?
  grade              String?
  enps               Int?
  completedAt        DateTime @default(now())
  survey             Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  link               SurveyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  answers            Answer[]

  @@index([surveyId])
  @@index([employeeId])
  @@index([completedAt])
}

model Answer {
  id         String         @id @default(cuid())
  responseId String
  questionId String
  valueInt   Int?
  valueText  String?
  valueJson  Json?
  response   Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId])
}
